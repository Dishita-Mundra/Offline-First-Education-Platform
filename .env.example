# GEMINI_API_KEY: Required for server-side Gemini AI Doubt Assistant (/api/ai/doubt).
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
APP_URL=

# Split Deployment (Frontend on Vercel + Backend on Render):
# Set VITE_API_URL in Vercel to your Render backend URL (e.g. https://indo-american-school-api.onrender.com)
VITE_API_URL=
# Set FRONTEND_URL in Render to your Vercel frontend URL(s), comma-separated (e.g. https://indo-american-school.vercel.app)
FRONTEND_URL=

# MongoDB Connection String (MongoDB Atlas or local MongoDB)
# When configured, Admin accounts, Teacher approvals, and platform records persist in MongoDB.
MONGODB_URI=

# Initial Admin Account Credentials & JWT Secret (server-side only; hashed with bcrypt before storage)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_JWT_SECRET=

# Optional Cloudinary credentials for uploaded media storage (falls back to local /uploads storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=


